---
/**
 * Decorative SVG pattern, absolutely positioned and hidden on mobile.
 * Three variants drawn from the brand visual identity:
 *   - "circuit"  → angular traces with junction dots (echoes the logo)
 *   - "waves"    → layered flowing curves (motion, dialogue, exchange)
 *   - "dots"     → scattered nodes (gentle texture for soft backgrounds)
 *
 * All variants render in the brand teal at low opacity. Purely visual;
 * hidden from assistive tech.
 */

type Props = {
  variant?: "circuit" | "waves" | "dots";
  side?: "right" | "left";
  /** "side" (default, ~28rem wide) or "full" (spans the whole parent). */
  cover?: "side" | "full";
  /** Tailwind opacity utility, e.g. "opacity-[0.18]". */
  opacityClass?: string;
};

const {
  variant = "circuit",
  side = "right",
  cover = "side",
  opacityClass = "opacity-[0.18]",
} = Astro.props;

// Unique id avoids <pattern> collisions when multiple full-cover patterns
// render on the same page.
const patternId = `pf-pat-${Math.random().toString(36).slice(2, 9)}`;
---

{
  cover === "full" && variant === "dots" && (
    <div
      aria-hidden="true"
      class:list={[
        "pointer-events-none absolute inset-0 -z-10 hidden md:block overflow-hidden",
        opacityClass,
      ]}
    >
      <svg
        width="100%"
        height="100%"
        xmlns="http://www.w3.org/2000/svg"
        class="text-[var(--color-teal)]"
      >
        <defs>
          <pattern
            id={patternId}
            x="0"
            y="0"
            width="48"
            height="48"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="24" cy="24" r="2.5" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patternId})`} />
      </svg>
    </div>
  )
}

{
  cover === "side" && (

<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute top-0 -z-10 hidden md:block",
    "h-full w-[28rem] lg:w-[34rem] overflow-hidden",
    opacityClass,
    side === "right" ? "right-0" : "left-0 scale-x-[-1]",
  ]}
>
  <svg
    viewBox="0 0 400 400"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-[var(--color-teal)]"
  >
    {
      variant === "circuit" && (
        <g>
          <path d="M0 80 L160 80 L200 40 L400 40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="160" cy="80" r="3.5" fill="currentColor" />
          <circle cx="200" cy="40" r="3.5" fill="currentColor" />
          <path d="M40 180 L260 180 L300 220 L400 220" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M260 180 L260 120" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="40" cy="180" r="3.5" fill="currentColor" />
          <circle cx="260" cy="180" r="3.5" fill="currentColor" />
          <circle cx="260" cy="120" r="3" fill="currentColor" />
          <circle cx="300" cy="220" r="3.5" fill="currentColor" />
          <path d="M80 300 L220 300 L260 340 L400 340" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="220" cy="300" r="3.5" fill="currentColor" />
          <circle cx="260" cy="340" r="3.5" fill="currentColor" />
          <circle cx="120" cy="240" r="2.5" fill="currentColor" />
          <circle cx="340" cy="120" r="2.5" fill="currentColor" />
          <circle cx="370" cy="280" r="2.5" fill="currentColor" />
          <circle cx="40" cy="360" r="2.5" fill="currentColor" />
        </g>
      )
    }

    {
      variant === "waves" && (
        <g stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round">
          <path d="M-20 90 Q 60 30 140 90 T 300 90 T 420 90" />
          <path d="M-20 170 Q 60 110 140 170 T 300 170 T 420 170" />
          <path d="M-20 250 Q 60 190 140 250 T 300 250 T 420 250" />
          <path d="M-20 330 Q 60 270 140 330 T 300 330 T 420 330" />
        </g>
      )
    }

    {
      variant === "dots" && (
        <g fill="currentColor">
          <circle cx="40" cy="60" r="3" />
          <circle cx="120" cy="40" r="3.5" />
          <circle cx="200" cy="80" r="3" />
          <circle cx="280" cy="50" r="3" />
          <circle cx="360" cy="90" r="3.5" />
          <circle cx="60" cy="140" r="3.5" />
          <circle cx="160" cy="160" r="3" />
          <circle cx="250" cy="140" r="3" />
          <circle cx="340" cy="170" r="3" />
          <circle cx="40" cy="240" r="3" />
          <circle cx="130" cy="230" r="3.5" />
          <circle cx="220" cy="260" r="3" />
          <circle cx="310" cy="240" r="3.5" />
          <circle cx="380" cy="270" r="3" />
          <circle cx="80" cy="330" r="3.5" />
          <circle cx="170" cy="350" r="3" />
          <circle cx="270" cy="330" r="3" />
          <circle cx="360" cy="360" r="3.5" />
        </g>
      )
    }
  </svg>
</div>
  )
}
