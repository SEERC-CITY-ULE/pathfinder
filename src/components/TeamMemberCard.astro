---
type Props = {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
};

const { name, role, bio, photo } = Astro.props;

const nameWords = name.split(/\s+/).filter(Boolean);
const initials =
  nameWords.length === 1
    ? nameWords[0][0].toUpperCase()
    : (nameWords[0][0] + nameWords[nameWords.length - 1][0]).toUpperCase();
---

<article class="flex flex-col items-start gap-4">
  {
    photo ? (
      <img
        src={photo}
        alt={`Portrait of ${name}`}
        width="96"
        height="96"
        class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover border border-[var(--color-border)]"
      />
    ) : (
      <div
        class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-[var(--color-teal)] text-white flex items-center justify-center font-display text-2xl font-semibold"
        aria-hidden="true"
      >
        {initials}
      </div>
    )
  }
  <div>
    <h4 class="font-display text-lg leading-tight">{name}</h4>
    <p class="text-xs font-semibold text-[var(--color-teal-deep)] uppercase tracking-wider mt-1">
      {role}
    </p>
    {
      bio && (
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mt-3">
          {bio}
        </p>
      )
    }
  </div>
</article>
