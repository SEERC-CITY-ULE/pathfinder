---
import TeamMemberCard from "./TeamMemberCard.astro";
import { site } from "~/data/site";

type TeamMember = {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
};

type Props = {
  name: string;
  shortName: string;
  country: string;
  role: "Coordinator" | "Beneficiary";
  summary: string;
  contribution: string;
  website?: string;
  logo?: string;
  team: TeamMember[];
};

const { name, shortName, country, role, summary, contribution, website, logo, team } = Astro.props;
const flag = site.countries.find((c) => c.name === country)?.flag ?? "";
---

<section class="border-t border-[var(--color-border)]">
  <div class="container-wide py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[18rem_1fr] lg:gap-16">
      <!-- Sidebar: identity -->
      <header>
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-3">
          {role === "Coordinator" ? "Coordinator" : "Partner"} · {shortName}
        </p>
        <h2 class="font-display text-2xl md:text-3xl leading-tight mb-3">{name}</h2>
        <p class="text-sm text-[var(--color-ink-soft)] mb-4">
          <span aria-hidden="true" class="mr-1">{flag}</span>{country}
        </p>
        {
          logo ? (
            <img
              src={logo}
              alt={`${name} logo`}
              class="mt-2 mb-4 max-h-16 w-auto"
            />
          ) : (
            <div
              class="mt-2 mb-4 w-16 h-16 rounded-lg bg-[var(--color-brand)] text-white flex items-center justify-center font-display text-base font-semibold"
              aria-hidden="true"
            >
              {shortName.slice(0, 4).toUpperCase()}
            </div>
          )
        }
        {
          website && (
            <p>
              <a
                href={website}
                rel="noopener"
                class="text-sm font-semibold text-[var(--color-brand)] hover:underline underline-offset-4"
              >
                Visit website ↗
              </a>
            </p>
          )
        }
      </header>

      <!-- Main: description + team -->
      <div>
        <p class="text-[1.05rem] text-[var(--color-ink)] leading-relaxed mb-4">{summary}</p>
        <p class="text-[var(--color-ink-soft)] leading-relaxed mb-10">
          <span class="font-semibold text-[var(--color-ink)]">In PATHFINDER:</span> {contribution}
        </p>

        {
          team.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-ink-soft)] mb-6">
                Team
              </h3>
              <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
                {team.map((m) => (
                  <TeamMemberCard
                    name={m.name}
                    role={m.role}
                    bio={m.bio}
                    photo={m.photo}
                  />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
