// Required disclaimer for EU-funded projects.
---

<div class="bg-[var(--color-brand)] text-white">
  <div class="container-wide py-6 md:py-8 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
    <svg
      viewBox="0 0 90 60"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Flag of the European Union"
      class="shrink-0 w-16 h-auto rounded-sm border border-white/20"
    >
      <rect width="90" height="60" fill="#003399" />
      <defs>
        <polygon
          id="eu-star"
          points="0,-3.5 0.79,-1.08 3.33,-1.08 1.27,0.41 2.06,2.83 0,1.34 -2.06,2.83 -1.27,0.41 -3.33,-1.08 -0.79,-1.08"
          fill="#FFCC00"
        />
      </defs>
      <use href="#eu-star" x="45" y="12" />
      <use href="#eu-star" x="54" y="14.41" />
      <use href="#eu-star" x="60.59" y="21" />
      <use href="#eu-star" x="63" y="30" />
      <use href="#eu-star" x="60.59" y="39" />
      <use href="#eu-star" x="54" y="45.59" />
      <use href="#eu-star" x="45" y="48" />
      <use href="#eu-star" x="36" y="45.59" />
      <use href="#eu-star" x="29.41" y="39" />
      <use href="#eu-star" x="27" y="30" />
      <use href="#eu-star" x="29.41" y="21" />
      <use href="#eu-star" x="36" y="14.41" />
    </svg>
    <p class="text-sm md:text-[0.95rem] leading-relaxed text-white/90">
      Funded by the European Union. Views and opinions expressed are those of the author(s) only and do not
      necessarily reflect those of the European Union or the European Education and Culture Executive Agency (EACEA).
      Neither the European Union nor the granting authority can be held responsible for them.
    </p>
  </div>
</div>
