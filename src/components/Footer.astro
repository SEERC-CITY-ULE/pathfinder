---
import EuFundingBanner from "~/components/EuFundingBanner.astro";
import { nav, site } from "~/data/site";
import { url } from "~/lib/url";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-surface-soft)]">
  <EuFundingBanner />

  <div class="container-wide py-12 md:py-16 grid gap-10 md:grid-cols-3">
    <div>
      <a href={url("/")} class="inline-flex items-center" aria-label={`${site.name} home`}>
        <img src={url("/images/logo.png")} alt="" aria-hidden="true" width="160" height="160" class="h-40 w-auto" />
        <span class="sr-only">{site.name}</span>
      </a>
      <p class="mt-4 text-sm text-[var(--color-ink-soft)] max-w-sm">{site.tagline}</p>
      <p class="mt-2 text-xs text-[var(--color-ink-faint)]">
        {site.grant.programme}
      </p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p class="font-semibold mb-3 text-[var(--color-ink)]">Navigate</p>
      <ul class="space-y-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="text-[var(--color-ink-soft)] hover:text-[var(--color-brand)] hover:underline underline-offset-4"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="text-sm">
      <p class="font-semibold mb-3 text-[var(--color-ink)]">Contact</p>
      <p class="text-[var(--color-ink-soft)]">
        {site.coordinator.contactName}<br />
        {site.coordinator.contactRole}<br />
        {site.coordinator.name}, {site.coordinator.country}
      </p>
      <p class="mt-3">
        <a
          href={`mailto:${site.coordinator.email}`}
          class="text-[var(--color-brand)] hover:underline underline-offset-4"
        >
          {site.coordinator.email}
        </a>
      </p>
    </div>
  </div>

  <div
    class="container-wide py-6 border-t border-[var(--color-border)] text-xs text-[var(--color-ink-faint)]"
  >
    <p>
      &copy; {year} PATHFINDER Consortium. Content licensed under
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        class="underline underline-offset-2 hover:text-[var(--color-brand)]"
        rel="license noopener"
      >
        CC BY 4.0
      </a>.
    </p>
  </div>
</footer>
