---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import ArticleLayout from "~/layouts/ArticleLayout.astro";
import { url } from "~/lib/url";
export async function getStaticPaths() {
  const items = await getCollection("events", ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const agendaHtml = item.data.agenda ? marked.parse(item.data.agenda) : null;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const dateLabel = item.data.endDate
  ? `${fmt(item.data.startDate)} – ${fmt(item.data.endDate)}`
  : fmt(item.data.startDate);
const meta = [
  { label: "When", value: item.data.time ? `${dateLabel}, ${item.data.time}` : dateLabel },
  { label: "Where", value: item.data.location, href: item.data.locationUrl },
  { label: "Format", value: item.data.format },
];
---
<ArticleLayout
  title={item.data.title}
  eyebrow="Event"
  description={item.data.summary}
  meta={meta}
  image={item.data.image}
>
  <p class="text-lg text-[var(--color-ink-soft)] leading-relaxed mb-8">{item.data.summary}</p>
  <Content />
  {
    agendaHtml && (
      <section class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <h2 class="font-display text-2xl md:text-3xl mb-6">Agenda</h2>
        <div class="prose-content" set:html={agendaHtml} />
      </section>
    )
  }
  {
    item.data.registrationUrl && (
      <p class="mt-10">
        <a href={item.data.registrationUrl} class="btn btn-primary" rel="noopener">
          Register →
        </a>
      </p>
    )
  }
  <p class="mt-12 pt-8 border-t border-[var(--color-border)]">
    <a href={url("/news-events")} class="text-[var(--color-brand)] hover:underline underline-offset-4">
      ← Back to news &amp; events
    </a>
  </p>
</ArticleLayout>
