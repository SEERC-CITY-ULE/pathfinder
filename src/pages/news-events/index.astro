---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import NewsCard from "~/components/NewsCard.astro";
import EventCard from "~/components/EventCard.astro";
import Pattern from "~/components/Pattern.astro";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const events = (await getCollection("events", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime(),
);
const now = Date.now();
const upcoming = events.filter((e) => e.data.startDate.getTime() >= now - 1000 * 60 * 60 * 24);
const past = events.filter((e) => e.data.startDate.getTime() < now - 1000 * 60 * 60 * 24).reverse();
---

<BaseLayout
  title="News & events"
  description="The latest news from the PATHFINDER project, plus upcoming and past events across the five partner countries."
>
  <section class="relative isolate container-wide pt-16 md:pt-24 pb-10">
    <Pattern variant="dots" side="right" />
    <div class="container-prose px-0">
      <h1 class="text-4xl md:text-6xl mb-6">News &amp; events</h1>
      <p class="text-lg md:text-xl text-[var(--color-ink-soft)] leading-relaxed">
        Project announcements, event recaps, and the calendar of public PATHFINDER activities — debates, career
        days, transnational forums, skills labs, and the closing EU policy roundtable.
      </p>
    </div>
  </section>

  <!-- UPCOMING EVENTS -->
  {
    upcoming.length > 0 && (
      <section class="container-wide py-12 md:py-16">
        <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
          <h2 class="text-2xl md:text-3xl">Upcoming events</h2>
          <p class="text-sm text-[var(--color-ink-faint)]">{upcoming.length} {upcoming.length === 1 ? "event" : "events"}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            upcoming.map((e) => (
              <EventCard
                href={`/news-events/events/${e.id}`}
                title={e.data.title}
                startDate={e.data.startDate}
                endDate={e.data.endDate}
                location={e.data.location}
                country={e.data.country}
                format={e.data.format}
                summary={e.data.summary}
              />
            ))
          }
        </div>
      </section>
    )
  }

  <!-- NEWS -->
  <section class="relative isolate overflow-hidden bg-[var(--color-surface-soft)] border-y border-[var(--color-border)]">
    <Pattern variant="waves" side="left" />
    <div class="container-wide py-16 md:py-20">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <h2 class="text-2xl md:text-3xl">News</h2>
        <a
          href="/news-events/rss.xml"
          class="text-sm font-medium text-[var(--color-brand)] hover:underline underline-offset-4"
        >
          RSS feed →
        </a>
      </div>
      {
        news.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {news.map((n) => (
              <NewsCard
                href={`/news-events/news/${n.id}`}
                title={n.data.title}
                date={n.data.date}
                summary={n.data.summary}
                image={n.data.image}
                tags={n.data.tags}
              />
            ))}
          </div>
        ) : (
          <p class="text-[var(--color-ink-soft)]">No news yet — check back soon.</p>
        )
      }
    </div>
  </section>

  <!-- PAST EVENTS -->
  {
    past.length > 0 && (
      <section class="container-wide py-16 md:py-20">
        <h2 class="text-2xl md:text-3xl mb-8">Past events</h2>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            past.map((e) => (
              <EventCard
                href={`/news-events/events/${e.id}`}
                title={e.data.title}
                startDate={e.data.startDate}
                endDate={e.data.endDate}
                location={e.data.location}
                country={e.data.country}
                format={e.data.format}
                summary={e.data.summary}
              />
            ))
          }
        </div>
      </section>
    )
  }
</BaseLayout>
