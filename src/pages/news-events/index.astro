---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import NewsCard from "~/components/NewsCard.astro";
import EventCard from "~/components/EventCard.astro";
import Pattern from "~/components/Pattern.astro";
import { url } from "~/lib/url";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const now = Date.now();
// Single events list, newest date first. Anything from yesterday onwards counts as upcoming
// so the day-of an event doesn't flip to "past" before it's finished.
const events = (await getCollection("events", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
const eventStatus = (startDate: Date): "upcoming" | "past" =>
  startDate.getTime() >= now - 1000 * 60 * 60 * 24 ? "upcoming" : "past";
---

<BaseLayout
  title="News & events"
  description="The latest news from the PATHFINDER project, plus upcoming and past events across the five partner countries."
>
  <section class="relative isolate container-wide pt-16 md:pt-24 pb-10">
    <Pattern variant="dots" side="right" />
    <div class="container-prose px-0">
      <h1 class="text-4xl md:text-6xl mb-6">News &amp; events</h1>
      <p class="text-lg md:text-xl text-[var(--color-ink-soft)] leading-relaxed">
        Follow PATHFINDER as it happens. From conversations and collaborations to workshops, meetings and key
        project moments, this is where you can keep up with the people, ideas and activities shaping our journey.
        Catch the latest stories, announcements and upcoming events, and see how PATHFINDER is bringing young
        people and labour market actors together across Europe.
      </p>
    </div>
  </section>

  <!-- EVENTS -->
  {
    events.length > 0 && (
      <section class="container-wide py-12 md:py-16">
        <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
          <h2 class="text-2xl md:text-3xl">Events</h2>
          <p class="text-sm text-[var(--color-ink-faint)]">{events.length} {events.length === 1 ? "event" : "events"}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            events.map((e) => (
              <EventCard
                href={url(`/news-events/events/${e.id}`)}
                title={e.data.title}
                startDate={e.data.startDate}
                endDate={e.data.endDate}
                location={e.data.location}
                country={e.data.country}
                format={e.data.format}
                summary={e.data.summary}
                status={eventStatus(e.data.startDate)}
              />
            ))
          }
        </div>
      </section>
    )
  }

  <!-- NEWS -->
  <section class="relative isolate overflow-hidden bg-[var(--color-surface-soft)] border-y border-[var(--color-border)]">
    <Pattern variant="waves" side="left" />
    <div class="container-wide py-16 md:py-20">
      <h2 class="text-2xl md:text-3xl mb-8">News</h2>
      {
        news.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {news.map((n) => (
              <NewsCard
                href={url(`/news-events/news/${n.id}`)}
                title={n.data.title}
                date={n.data.date}
                summary={n.data.summary}
                image={n.data.image}
                tags={n.data.tags}
              />
            ))}
          </div>
        ) : (
          <p class="text-[var(--color-ink-soft)]">No news yet — check back soon.</p>
        )
      }
    </div>
  </section>

</BaseLayout>
