---
import { getCollection, render } from "astro:content";
import ArticleLayout from "~/layouts/ArticleLayout.astro";
import { url } from "~/lib/url";

export async function getStaticPaths() {
  const items = await getCollection("outputs");
  return items.map((item) => ({
    params: { slug: item.data.id.toLowerCase().replace(".", "-") },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const resolvedFileUrl = item.data.fileUrl
  ? item.data.fileUrl.startsWith("/")
    ? url(item.data.fileUrl)
    : item.data.fileUrl
  : undefined;
const isPdf = resolvedFileUrl ? /\.pdf($|\?)/i.test(resolvedFileUrl) : false;
---

<ArticleLayout
  title={item.data.title}
  eyebrow="Output"
  description={item.data.summary}
>
  <p class="text-lg text-[var(--color-ink-soft)] leading-relaxed mb-8">{item.data.summary}</p>
  <Content />

  {
    resolvedFileUrl && (
      <div class="mt-10 space-y-6">
        <p>
          <a
            href={resolvedFileUrl}
            class="btn btn-primary"
            target="_blank"
            rel="noopener"
            download={item.data.fileUrl?.startsWith("/") ? "" : undefined}
          >
            {isPdf ? "Download deliverable (PDF) ↗" : "Download deliverable ↗"}
          </a>
        </p>
        {isPdf && (
          <div class="rounded-lg border border-[var(--color-border)] overflow-hidden bg-[var(--color-surface-soft)]">
            <iframe
              src={resolvedFileUrl}
              title={`${item.data.title} PDF preview`}
              class="w-full h-[600px]"
              loading="lazy"
            />
          </div>
        )}
      </div>
    )
  }

  <p class="mt-12 pt-8 border-t border-[var(--color-border)]">
    <a href={url("/outputs")} class="text-[var(--color-brand)] hover:underline underline-offset-4">
      ← Back to outputs
    </a>
  </p>
</ArticleLayout>
