---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { url } from "~/lib/url";
---

<BaseLayout title="Page not found" noindex>
  <section class="container-wide py-32 text-center">
    <p class="eyebrow mb-4">404</p>
    <h1 class="text-5xl md:text-6xl mb-6">Page not found.</h1>
    <p class="text-lg text-[var(--color-ink-soft)] max-w-md mx-auto mb-10">
      The page you're looking for has moved or doesn't exist. Try the navigation, or jump back to the homepage.
    </p>
    <a href={url("/")} class="btn btn-primary">Go to homepage</a>
  </section>
</BaseLayout>
