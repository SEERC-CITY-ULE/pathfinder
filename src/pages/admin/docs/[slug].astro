---
import DocsLayout from "~/layouts/DocsLayout.astro";
import { docs } from "~/data/docs";
import { loadDoc } from "~/lib/docs";

export async function getStaticPaths() {
  return docs.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const meta = docs.find((d) => d.slug === slug);
if (!meta) return Astro.redirect("/admin/docs/");

const doc = loadDoc(slug!);
if (!doc) return Astro.redirect("/admin/docs/");
---

<DocsLayout activeSlug={slug!} title={meta.title} description={meta.description}>
  <div set:html={doc.html} />
</DocsLayout>
