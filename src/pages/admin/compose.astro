---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/data/site";
import { url } from "~/lib/url";

const countries = [
  "Slovakia",
  "Greece",
  "Bosnia & Herzegovina",
  "Bulgaria",
  "Serbia",
  "Italy",
  "United Kingdom",
  "European Union",
  "Online",
];

const logoUrl = url("/images/logo.png");
---

<BaseLayout
  title="Compose"
  description="Internal helper for creating news, event, and output posts. Nothing is published from this page."
  noindex
>
  <div class="container-wide py-10 md:py-14">
    <header class="mb-8 max-w-3xl">
      <p class="eyebrow mb-3">Internal tool</p>
      <h1 class="text-3xl md:text-5xl mb-4">Compose a post</h1>
      <p class="text-[var(--color-ink-soft)] leading-relaxed">
        Fill in the form and the correctly-formatted Markdown appears on the right. Copy or download it, then
        send it to the publisher (or upload it to GitHub). <strong class="text-[var(--color-ink)]">This page publishes
        nothing on its own</strong> — it's just a formatter to save you from writing YAML by hand.
      </p>
    </header>

    <!-- TYPE TOGGLE -->
    <div class="mb-8 inline-flex rounded-full border border-[var(--color-border-strong)] p-1 bg-[var(--color-surface-soft)]">
      <button
        type="button"
        data-type="news"
        class="type-toggle px-5 py-2 rounded-full text-sm font-semibold transition-colors"
        aria-pressed="true"
      >
        News item
      </button>
      <button
        type="button"
        data-type="event"
        class="type-toggle px-5 py-2 rounded-full text-sm font-semibold transition-colors"
        aria-pressed="false"
      >
        Event
      </button>
      <button
        type="button"
        data-type="output"
        class="type-toggle px-5 py-2 rounded-full text-sm font-semibold transition-colors"
        aria-pressed="false"
      >
        Output
      </button>
    </div>

    <div class="grid gap-10 lg:grid-cols-2">
      <!-- ─── FORM ────────────────────────────────────────────────── -->
      <form id="composer-form" class="space-y-5" novalidate>
        <div class="form-field">
          <label for="f-title">Title <span class="req">·</span></label>
          <input id="f-title" name="title" type="text" required maxlength="120" placeholder="A short, punchy headline" />
        </div>

        <!-- OUTPUT-ONLY METADATA FIELDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 hidden" data-only="output">
          <div class="form-field">
            <label for="f-outputId">Deliverable ID <span class="req">·</span></label>
            <input id="f-outputId" name="outputId" type="text" value="D6.1" placeholder="e.g. D6.1" />
            <p class="help">Format: <code>D#.#</code> (e.g. D6.1, D19.1)</p>
          </div>
          <div class="form-field flex flex-col justify-center pt-5">
            <label class="inline-flex items-center gap-2.5 cursor-pointer">
              <input id="f-featured" name="featured" type="checkbox" checked class="!w-4 !h-4 accent-[var(--color-brand)]" />
              <span class="text-sm font-semibold text-[var(--color-ink)]">Show on Outputs page</span>
            </label>
            <p class="help">Sets <code>featured: true</code></p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-field" data-only="news">
            <label for="f-date">Date <span class="req">·</span></label>
            <input id="f-date" name="date" type="date" required />
          </div>
          <div class="form-field hidden" data-only="event">
            <label for="f-startDate">Start date <span class="req">·</span></label>
            <input id="f-startDate" name="startDate" type="date" required />
          </div>
          <div class="form-field hidden" data-only="event">
            <label for="f-endDate">End date <span class="opt">optional</span></label>
            <input id="f-endDate" name="endDate" type="date" />
          </div>
        </div>

        <!-- EVENT-ONLY FIELDS -->
        <div class="form-field hidden" data-only="event">
          <label for="f-location">Location <span class="req">·</span></label>
          <input id="f-location" name="location" type="text" placeholder="City, Country (or 'Online')" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-field hidden" data-only="event">
            <label for="f-country">Country <span class="req">·</span></label>
            <select id="f-country" name="country">
              {countries.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="form-field hidden" data-only="event">
            <label for="f-format">Format <span class="req">·</span></label>
            <select id="f-format" name="format">
              <option value="In-person">In-person</option>
              <option value="Online">Online</option>
              <option value="Hybrid">Hybrid</option>
            </select>
          </div>
        </div>

        <div class="form-field hidden" data-only="event">
          <label for="f-registrationUrl">Registration URL <span class="opt">optional</span></label>
          <input id="f-registrationUrl" name="registrationUrl" type="url" placeholder="https://..." />
        </div>

        <div class="form-field hidden" data-only="event">
          <label for="f-agenda">Agenda <span class="opt">optional</span></label>
          <textarea
            id="f-agenda"
            name="agenda"
            rows="6"
            placeholder={`One item per line. Markdown works.

09:00 — Registration & coffee
09:30 — Opening remarks
10:00 — Panel: AI and youth employability
11:30 — Break
`}
          ></textarea>
          <p class="help">Rendered as its own "Agenda" section on the event page.</p>
        </div>

        <!-- SHARED FIELDS -->
        <div class="form-field">
          <label for="f-summary">Summary <span class="req">·</span></label>
          <textarea
            id="f-summary"
            name="summary"
            rows="2"
            required
            minlength="20"
            placeholder="One or two sentences shown on the card preview. At least 20 characters."
          ></textarea>
          <p class="help">Shown on the card, the top of the detail page, and social-media share previews.</p>
        </div>

        <div class="form-field">
          <div class="flex items-center justify-between mb-1">
            <label for="f-body" class="!mb-0">Body</label>
            <button
              type="button"
              id="insert-output-template-btn"
              data-only="output"
              class="hidden text-xs font-semibold text-[var(--color-teal-deep)] hover:text-[var(--color-brand)] underline underline-offset-2 cursor-pointer"
            >
              + Insert standard Output sections
            </button>
          </div>
          <div class="md-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" data-md="bold" class="md-btn" title="Bold — wraps selection in **">
              <strong>B</strong>
            </button>
            <button type="button" data-md="link" class="md-btn" title="Insert a link">
              🔗 Link
            </button>
            <button type="button" data-md="h2" class="md-btn" title="Section heading">
              H2
            </button>
            <button type="button" data-md="h3" class="md-btn" title="Sub-heading">
              H3
            </button>
            <button type="button" data-md="list" class="md-btn" title="Bulleted list">
              • List
            </button>
            <button type="button" data-md="quote" class="md-btn" title="Quote block">
              ❝ Quote
            </button>
          </div>
          <textarea
            id="f-body"
            name="body"
            rows="10"
            placeholder="The full article text in Markdown.

## Use headings like this
**Bold** and [links](https://example.org) work too.

- Bullet lists
- Are supported"
          ></textarea>
          <p class="help">
            Select some text and click a toolbar button, or type
            <a href="https://commonmark.org/help/" rel="noopener" target="_blank" class="link">Markdown</a>
            directly.
          </p>
        </div>

        <!-- OUTPUT-ONLY PDF SECTION -->
        <div class="rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-soft)] p-5 space-y-4 hidden" data-only="output">
          <div>
            <h3 class="font-display text-lg text-[var(--color-ink)] mb-1">Deliverable PDF <span class="text-xs font-normal text-[var(--color-ink-faint)]">optional</span></h3>
            <p class="text-xs text-[var(--color-ink-soft)] leading-relaxed">
              Attach a PDF from your computer (or paste an external link) to show a <strong>"Download deliverable (PDF) ↗"</strong> button and embedded PDF viewer on the output page.
            </p>
          </div>

          <div class="form-field">
            <label for="f-pdfFile">1. Choose a PDF file from your computer</label>
            <input
              id="f-pdfFile"
              type="file"
              accept=".pdf,application/pdf"
              class="!bg-white cursor-pointer"
            />
            <p class="help">
              Selecting a PDF automatically fills the path below (<code>/files/…pdf</code>) and previews the PDF on the right.
            </p>
          </div>

          <div class="form-field">
            <label for="f-fileUrl">2. PDF path on the site or external URL</label>
            <div class="flex gap-2">
              <input
                id="f-fileUrl"
                name="fileUrl"
                type="text"
                placeholder="/files/d6-1-report.pdf or https://..."
              />
              <button
                type="button"
                id="clear-pdf-btn"
                class="btn btn-secondary text-xs px-3 py-1.5 shrink-0 hidden"
              >
                Clear
              </button>
            </div>
            <p class="help">
              For uploaded PDFs, place the PDF file in <code>public/files/</code> in the repository so it matches this path.
            </p>
          </div>
        </div>

        <div class="form-field" data-only="news">
          <label for="f-tags">Tags <span class="opt">optional</span></label>
          <input id="f-tags" name="tags" type="text" placeholder="event-recap, milestone" />
          <p class="help">Comma-separated. Kept simple and lowercase.</p>
        </div>

        <div class="form-field" data-only="news">
          <label for="f-author">Author <span class="opt">optional</span></label>
          <input id="f-author" name="author" type="text" placeholder="Coordinator's name" />
        </div>

        <details class="form-details" id="image-details-section">
          <summary>Add an image <span class="opt">optional</span></summary>
          <div class="space-y-4 mt-4">
            <div class="form-field">
              <label for="f-imgSrc">Image URL</label>
              <input id="f-imgSrc" name="imgSrc" type="text" placeholder="/images/news/your-photo.jpg" />
              <p class="help">
                Where the file lives on the site. The publisher will upload the actual file to that
                path. If left blank, the PATHFINDER logo is used automatically.
              </p>
            </div>
            <div class="form-field">
              <label for="f-imgAlt">Alt text</label>
              <input id="f-imgAlt" name="imgAlt" type="text" placeholder="Short description of what the photo shows" />
              <p class="help">A one-line description for screen readers and search engines.</p>
            </div>
            <div class="form-field">
              <label for="f-imgCredit">Credit</label>
              <input id="f-imgCredit" name="imgCredit" type="text" placeholder="Photographer Name on Source (License)" />
              <p class="help">Required for Creative Commons images.</p>
            </div>
          </div>
        </details>
      </form>

      <!-- ─── PREVIEW ─────────────────────────────────────────────── -->
      <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-ink-soft)] mb-3">
            Card preview
          </h2>
          <!-- News card shape -->
          <article id="pv-news-card" class="surface-card overflow-hidden flex flex-col max-w-md">
            <img
              id="pv-image"
              src={logoUrl}
              data-fallback={logoUrl}
              alt=""
              class="w-full h-44 object-contain bg-[var(--color-surface-soft)] p-5"
            />
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-3 text-xs text-[var(--color-ink-faint)]">
                <time id="pv-date-label">—</time>
                <span id="pv-tag-wrap" hidden>
                  <span aria-hidden="true">·</span>
                  <span class="uppercase tracking-wider ml-2" id="pv-tag"></span>
                </span>
              </div>
              <h3 class="font-display text-xl leading-tight mb-3" id="pv-title">Your headline will appear here</h3>
              <p class="text-sm text-[var(--color-ink-soft)] mb-4 flex-1" id="pv-summary">Your summary will appear here.</p>
              <span class="text-sm font-medium text-[var(--color-brand)]">Read more →</span>
            </div>
          </article>

          <!-- Event card shape (hidden until event mode) -->
          <article id="pv-event-card" class="surface-card p-6 md:p-7 flex flex-col max-w-md hidden">
            <div class="flex items-center gap-2 mb-4 text-xs">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-[var(--color-teal)] text-white font-semibold" id="pv-format">In-person</span>
            </div>
            <p class="text-sm font-semibold text-[var(--color-accent)] mb-2" id="pv-event-date">—</p>
            <h3 class="font-display text-xl leading-tight mb-2" id="pv-event-title">Your event title</h3>
            <p class="text-sm text-[var(--color-ink-soft)] mb-3">
              <span id="pv-event-location">City, Country</span>
            </p>
            <p class="text-sm text-[var(--color-ink-soft)] mb-4 flex-1" id="pv-event-summary">Your summary will appear here.</p>
            <span class="text-sm font-medium text-[var(--color-brand)]">Event details →</span>
          </article>

          <!-- Output card shape (hidden until output mode) -->
          <article id="pv-output-card" class="surface-card p-6 md:p-8 flex flex-col max-w-md hidden">
            <h3 class="font-display text-xl leading-tight mb-3" id="pv-output-title">Your output title</h3>
            <p class="text-sm text-[var(--color-ink-soft)] flex-1" id="pv-output-summary">Your summary will appear here.</p>
            <p class="mt-5 text-sm font-semibold text-[var(--color-brand)]">Read more →</p>
          </article>
        </div>

        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-ink-soft)] mb-3">
            Article preview
          </h2>
          <div class="surface-card p-6 max-w-md">
            <h1 class="font-display text-2xl mb-2" id="pv-article-title">Your headline</h1>
            <p class="text-xs text-[var(--color-ink-faint)] mb-4" id="pv-article-meta">—</p>
            <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-4 hidden" id="pv-output-lead-summary"></p>
            <div class="prose-content text-sm" id="pv-article-body"><p>Body preview…</p></div>
            <div id="pv-output-download-wrap" class="mt-5 space-y-3 hidden">
              <a
                id="pv-output-download-link"
                href="#"
                target="_blank"
                rel="noopener"
                class="btn btn-primary text-xs py-2 px-4 inline-flex"
              >
                Download deliverable (PDF) ↗
              </a>
              <div id="pv-output-pdf-wrap" class="rounded border border-[var(--color-border)] overflow-hidden bg-[var(--color-surface-soft)] hidden">
                <iframe
                  id="pv-output-pdf-frame"
                  title="Selected PDF preview"
                  class="w-full h-64"
                ></iframe>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-baseline justify-between mb-3">
            <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-ink-soft)]">
              Markdown to copy
            </h2>
            <span class="text-xs text-[var(--color-ink-faint)]" id="pv-word-count">0 words</span>
          </div>
          <div class="rounded-lg border border-[var(--color-border)] overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2 bg-[var(--color-surface-soft)] border-b border-[var(--color-border)] text-xs gap-2 flex-wrap">
              <code id="pv-filename" class="font-mono text-[var(--color-ink-soft)]">YYYY-MM-DD-title.md</code>
              <div class="flex items-center gap-2 flex-wrap">
                <button
                  id="download-pdf-btn"
                  type="button"
                  class="btn btn-secondary text-xs py-1.5 px-3 hidden"
                  title="Save the selected PDF with the exact filename expected in public/files/"
                >
                  ↓ Save renamed PDF
                </button>
                <button
                  id="download-btn"
                  type="button"
                  class="btn btn-primary text-xs py-1.5 px-3"
                >
                  ↓ Download .md
                </button>
                <button
                  id="copy-btn"
                  type="button"
                  class="btn btn-secondary text-xs py-1.5 px-3"
                >
                  Copy
                </button>
              </div>
            </div>
            <pre class="p-4 text-xs font-mono text-[var(--color-ink)] whitespace-pre-wrap break-words max-h-64 overflow-auto"><code id="pv-markdown">…</code></pre>
          </div>
          <p id="copy-status" class="mt-2 text-sm text-[var(--color-teal-deep)] font-semibold" hidden>Copied to clipboard ✓</p>
        </div>
      </aside>
    </div>

    <!-- INSTRUCTIONS -->
    <section class="mt-16 max-w-3xl border-t border-[var(--color-border)] pt-10">
      <h2 class="text-2xl md:text-3xl mb-6">What to do with the downloaded file</h2>
      <ol class="space-y-4 text-[var(--color-ink-soft)] leading-relaxed">
        <li>
          <span class="inline-block w-6 font-semibold text-[var(--color-brand)]">1.</span>
          Click <strong class="text-[var(--color-ink)]">↓ Download .md</strong> (or <strong class="text-[var(--color-ink)]">Copy</strong>) above. If you attached a PDF for an Output, also click <strong class="text-[var(--color-ink)]">↓ Save renamed PDF</strong>.
        </li>
        <li>
          <span class="inline-block w-6 font-semibold text-[var(--color-brand)]">2.</span>
          Send the file(s) — along with any image or PDF attachment — to
          <a href={`mailto:${site.coordinator.email}?subject=${encodeURIComponent("New PATHFINDER post")}`} class="link">
            {site.coordinator.email}
          </a>, or upload directly to GitHub if you have write access.
        </li>
        <li>
          <span class="inline-block w-6 font-semibold text-[var(--color-brand)]">3.</span>
          The publisher uploads the <code>.md</code> file into <code>src/content/news/</code>,
          <code>src/content/events/</code>, or <code>src/content/outputs/</code> on GitHub (and any deliverable PDF into <code>public/files/</code>). The post appears on the live site
          within about a minute.
        </li>
      </ol>
      <p class="mt-6 text-sm text-[var(--color-ink-faint)]">
        Nothing on this page connects to GitHub, sends emails on your behalf, or writes to the site.
        You control what gets sent, and the publisher controls what gets published.
      </p>
    </section>
  </div>

  <style>
    .type-toggle {
      color: var(--color-ink-soft);
    }
    .type-toggle[aria-pressed="true"] {
      background: var(--color-brand);
      color: white;
    }

    .form-field label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-ink);
      margin-bottom: 0.4rem;
    }
    .form-field .req {
      color: var(--color-accent);
      font-weight: 700;
    }
    .form-field .opt {
      color: var(--color-ink-faint);
      font-weight: 400;
      font-size: 0.75rem;
    }
    .form-field input,
    .form-field textarea,
    .form-field select {
      width: 100%;
      background: white;
      border: 1px solid var(--color-border-strong);
      border-radius: 0.5rem;
      padding: 0.65rem 0.85rem;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--color-ink);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-field textarea {
      resize: vertical;
      min-height: 5rem;
      line-height: 1.5;
    }
    .form-field input:focus,
    .form-field textarea:focus,
    .form-field select:focus {
      outline: none;
      border-color: var(--color-brand);
      box-shadow: 0 0 0 3px rgba(20, 59, 99, 0.15);
    }
    .form-field .help {
      margin-top: 0.4rem;
      font-size: 0.8rem;
      color: var(--color-ink-faint);
      line-height: 1.5;
    }
    .form-field .help code {
      background: var(--color-surface-soft);
      padding: 0.05rem 0.35rem;
      border-radius: 0.25rem;
      font-size: 0.8em;
    }
    .form-details summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--color-ink);
      padding: 0.5rem 0;
      user-select: none;
    }
    .form-details summary:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
      border-radius: 2px;
    }
    .link {
      color: var(--color-teal-deep);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .link:hover {
      color: var(--color-brand);
    }

    #pv-article-body :is(h2, h3) {
      font-family: var(--font-display);
      margin-top: 1.2em;
      margin-bottom: 0.4em;
    }
    #pv-article-body h2 { font-size: 1.15rem; }
    #pv-article-body h3 { font-size: 1rem; }
    #pv-article-body p { margin: 0.6em 0; }
    #pv-article-body ul, #pv-article-body ol { padding-left: 1.4em; margin: 0.6em 0; }
    #pv-article-body ul { list-style: disc; }
    #pv-article-body ol { list-style: decimal; }
    #pv-article-body a { color: var(--color-teal-deep); text-decoration: underline; }

    /* Markdown toolbar above the body textarea */
    .md-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      padding: 0.35rem;
      background: var(--color-surface-soft);
      border: 1px solid var(--color-border);
      border-bottom: none;
      border-radius: 0.5rem 0.5rem 0 0;
    }
    .md-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.3rem 0.7rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-ink-soft);
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 0.375rem;
      cursor: pointer;
      line-height: 1;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .md-btn:hover {
      background: var(--color-brand);
      color: white;
      border-color: var(--color-brand);
    }
    .md-btn:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
    /* Blend the toolbar with the textarea beneath it */
    .md-toolbar + textarea {
      border-top-left-radius: 0;
      border-top-right-radius: 0;
    }
  </style>

  <script>
    import { marked } from "marked";

    marked.setOptions({ gfm: true, breaks: false });

    type PostType = "news" | "event" | "output";
    let currentType: PostType = "news";

    const form = document.getElementById("composer-form") as HTMLFormElement;
    const dateInput = document.getElementById("f-date") as HTMLInputElement;
    const startDateInput = document.getElementById("f-startDate") as HTMLInputElement;
    const pdfFileInput = document.getElementById("f-pdfFile") as HTMLInputElement;
    const fileUrlInput = document.getElementById("f-fileUrl") as HTMLInputElement;
    const clearPdfBtn = document.getElementById("clear-pdf-btn") as HTMLButtonElement;
    const downloadPdfBtn = document.getElementById("download-pdf-btn") as HTMLButtonElement;
    const insertOutputTemplateBtn = document.getElementById(
      "insert-output-template-btn",
    ) as HTMLButtonElement;

    let selectedPdfFile: File | null = null;
    let selectedPdfObjectUrl: string | null = null;

    // Default the date to today.
    const todayISO = new Date().toISOString().slice(0, 10);
    dateInput.value = todayISO;
    startDateInput.value = todayISO;

    // ── Helpers ────────────────────────────────────────────────
    function slugify(text: string): string {
      return text
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .trim()
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-")
        .slice(0, 60);
    }

    function slugifyOutputId(id: string): string {
      return (id || "D1.1")
        .trim()
        .toLowerCase()
        .replace(/\./g, "-")
        .replace(/[^a-z0-9-]/g, "");
    }

    function fmtDate(iso: string): string {
      if (!iso) return "—";
      const d = new Date(iso + "T00:00");
      if (Number.isNaN(d.getTime())) return "—";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
    }

    function fmtShortDate(iso: string): string {
      if (!iso) return "";
      const d = new Date(iso + "T00:00");
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
    }

    function escapeYaml(v: string): string {
      const str = String(v);
      if (str === "") return '""';
      if (/[:#&*!|>'%@`\[\]{}]|^\s|\s$/.test(str) || str.includes("\n")) {
        return `"${str.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
      }
      return str;
    }

    function parseTags(raw: string): string[] {
      return raw
        .split(",")
        .map((t) => t.trim().toLowerCase())
        .filter(Boolean);
    }

    function getFormValue(name: string): string {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      return el?.value?.trim() ?? "";
    }

    function getSuggestedPdfFilename(): string {
      const idSlug = slugifyOutputId(getFormValue("outputId") || "D6.1");
      const titleSlug = slugify(getFormValue("title"));
      if (titleSlug) {
        return `${idSlug}-${titleSlug}.pdf`;
      }
      if (selectedPdfFile) {
        const baseName = selectedPdfFile.name.replace(/\.pdf$/i, "");
        const fileSlug = slugify(baseName) || "deliverable";
        return fileSlug.startsWith(idSlug) ? `${fileSlug}.pdf` : `${idSlug}-${fileSlug}.pdf`;
      }
      return `${idSlug}-deliverable.pdf`;
    }

    // ── PDF file selection & clear ─────────────────────────────
    pdfFileInput.addEventListener("change", () => {
      const file = pdfFileInput.files?.[0] ?? null;
      if (selectedPdfObjectUrl) {
        URL.revokeObjectURL(selectedPdfObjectUrl);
        selectedPdfObjectUrl = null;
      }
      selectedPdfFile = file;
      if (file) {
        selectedPdfObjectUrl = URL.createObjectURL(file);
        const suggested = getSuggestedPdfFilename();
        if (!fileUrlInput.value.trim() || fileUrlInput.value.trim().startsWith("/files/")) {
          fileUrlInput.value = `/files/${suggested}`;
        }
      }
      updatePreview();
    });

    clearPdfBtn.addEventListener("click", () => {
      pdfFileInput.value = "";
      fileUrlInput.value = "";
      if (selectedPdfObjectUrl) {
        URL.revokeObjectURL(selectedPdfObjectUrl);
        selectedPdfObjectUrl = null;
      }
      selectedPdfFile = null;
      updatePreview();
    });

    // ── Type toggle ────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>(".type-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type as PostType;
        if (type === currentType) return;
        currentType = type;
        document.querySelectorAll<HTMLButtonElement>(".type-toggle").forEach((b) => {
          b.setAttribute("aria-pressed", String(b.dataset.type === type));
        });
        document.querySelectorAll<HTMLElement>("[data-only]").forEach((el) => {
          el.classList.toggle("hidden", el.dataset.only !== type);
        });
        document.getElementById("image-details-section")?.classList.toggle("hidden", type === "output");
        document.getElementById("pv-news-card")?.classList.toggle("hidden", type !== "news");
        document.getElementById("pv-event-card")?.classList.toggle("hidden", type !== "event");
        document.getElementById("pv-output-card")?.classList.toggle("hidden", type !== "output");
        updatePreview();
      });
    });

    // ── Output template helper ─────────────────────────────────
    insertOutputTemplateBtn.addEventListener("click", () => {
      const title = getFormValue("title") || "Deliverable Title";
      const template = [
        `Following the project activities across the partner countries, the **${title}** brings the findings together into a single, comparable picture.`,
        "",
        "It captures:",
        "",
        "- **Key finding or pillar 1** — brief explanation of what this section covers.",
        "- **Key finding or pillar 2** — brief explanation of the methodology or insights.",
        "- **Key finding or pillar 3** — best practices and inclusive approaches for engaging youth.",
        "- **Recommendations** — actionable next steps for young people, employers, and policymakers.",
        "",
        "The report is published openly as part of PATHFINDER's public deliverables.",
      ].join("\n");

      const bodyField = document.getElementById("f-body") as HTMLTextAreaElement;
      if (bodyField.value.trim() && !window.confirm("Replace current body text with the standard Output template?")) {
        return;
      }
      bodyField.value = template;
      bodyField.dispatchEvent(new Event("input", { bubbles: true }));
    });

    // ── Preview + output ───────────────────────────────────────
    function buildFilename(): string {
      const title = getFormValue("title") || "untitled";
      if (currentType === "output") {
        const idSlug = slugifyOutputId(getFormValue("outputId") || "D6.1");
        return `${idSlug}-${slugify(title) || "output"}.md`;
      }
      const date =
        currentType === "news"
          ? getFormValue("date") || todayISO
          : getFormValue("startDate") || todayISO;
      return `${date}-${slugify(title) || "untitled"}.md`;
    }

    function buildFrontmatterAndBody(): string {
      const title = getFormValue("title");
      const summary = getFormValue("summary");
      const body = (form.elements.namedItem("body") as HTMLTextAreaElement)?.value ?? "";
      const imgSrc = getFormValue("imgSrc");
      const imgAlt = getFormValue("imgAlt");
      const imgCredit = getFormValue("imgCredit");

      const lines: string[] = ["---"];

      if (currentType === "news") {
        lines.push(`title: ${escapeYaml(title)}`);
        lines.push(`date: ${getFormValue("date") || todayISO}`);
        lines.push(`summary: ${escapeYaml(summary)}`);
        const author = getFormValue("author");
        if (author) lines.push(`author: ${escapeYaml(author)}`);
        const tags = parseTags(getFormValue("tags"));
        if (tags.length > 0) {
          lines.push("tags:");
          for (const t of tags) lines.push(`  - ${escapeYaml(t)}`);
        }
      } else if (currentType === "event") {
        lines.push(`title: ${escapeYaml(title)}`);
        lines.push(`startDate: ${getFormValue("startDate") || todayISO}`);
        const endDate = getFormValue("endDate");
        if (endDate) lines.push(`endDate: ${endDate}`);
        lines.push(`location: ${escapeYaml(getFormValue("location"))}`);
        lines.push(`country: ${escapeYaml(getFormValue("country"))}`);
        lines.push(`format: ${escapeYaml(getFormValue("format"))}`);
        lines.push(`summary: ${escapeYaml(summary)}`);
        const reg = getFormValue("registrationUrl");
        if (reg) lines.push(`registrationUrl: ${escapeYaml(reg)}`);
        const agenda = (form.elements.namedItem("agenda") as HTMLTextAreaElement)?.value ?? "";
        if (agenda.trim()) {
          // Emit as YAML block scalar so newlines survive intact
          const indented = agenda.replace(/\n/g, "\n  ");
          lines.push(`agenda: |\n  ${indented}`);
        }
      } else {
        const outputId = (getFormValue("outputId") || "D6.1").toUpperCase();
        const featuredEl = document.getElementById("f-featured") as HTMLInputElement;
        const featured = featuredEl ? featuredEl.checked : true;
        const fileUrl = getFormValue("fileUrl");

        lines.push(`id: ${escapeYaml(outputId)}`);
        lines.push(`title: ${escapeYaml(title)}`);
        lines.push(`summary: ${escapeYaml(summary)}`);
        lines.push(`featured: ${featured}`);
        if (fileUrl) {
          lines.push(`fileUrl: ${escapeYaml(fileUrl)}`);
        }
      }

      if (imgSrc) {
        lines.push("image:");
        lines.push(`  src: ${escapeYaml(imgSrc)}`);
        lines.push(`  alt: ${escapeYaml(imgAlt)}`);
        if (imgCredit) lines.push(`  credit: ${escapeYaml(imgCredit)}`);
      }

      lines.push("---");
      lines.push("");
      lines.push(body);

      return lines.join("\n").trimEnd() + "\n";
    }

    function updatePreview(): void {
      const title = getFormValue("title") || "Your headline will appear here";
      const summary = getFormValue("summary") || "Your summary will appear here.";
      const body = (form.elements.namedItem("body") as HTMLTextAreaElement)?.value ?? "";
      const imgSrc = getFormValue("imgSrc");
      const imgAlt = getFormValue("imgAlt");

      // Shared: card title/summary + image
      const image = document.getElementById("pv-image") as HTMLImageElement;
      image.src = imgSrc || image.dataset.fallback || "/images/logo.png";
      image.alt = imgAlt || "";

      const leadSummaryEl = document.getElementById("pv-output-lead-summary") as HTMLElement;
      const outputDownloadWrap = document.getElementById("pv-output-download-wrap") as HTMLElement;
      const outputDownloadLink = document.getElementById("pv-output-download-link") as HTMLAnchorElement;
      const outputPdfWrap = document.getElementById("pv-output-pdf-wrap") as HTMLElement;
      const outputPdfFrame = document.getElementById("pv-output-pdf-frame") as HTMLIFrameElement;

      if (currentType === "news") {
        (document.getElementById("pv-title") as HTMLElement).textContent = title;
        (document.getElementById("pv-summary") as HTMLElement).textContent = summary;
        const isoDate = getFormValue("date") || todayISO;
        (document.getElementById("pv-date-label") as HTMLTimeElement).textContent = fmtDate(isoDate);
        (document.getElementById("pv-date-label") as HTMLTimeElement).dateTime = isoDate;
        const tags = parseTags(getFormValue("tags"));
        const tagWrap = document.getElementById("pv-tag-wrap") as HTMLElement;
        if (tags.length > 0) {
          (document.getElementById("pv-tag") as HTMLElement).textContent = tags[0];
          tagWrap.hidden = false;
        } else {
          tagWrap.hidden = true;
        }
        leadSummaryEl.classList.add("hidden");
        outputDownloadWrap.classList.add("hidden");
        downloadPdfBtn.classList.add("hidden");
      } else if (currentType === "event") {
        (document.getElementById("pv-event-title") as HTMLElement).textContent = title;
        (document.getElementById("pv-event-summary") as HTMLElement).textContent = summary;
        (document.getElementById("pv-event-location") as HTMLElement).textContent =
          getFormValue("location") || "City, Country";
        (document.getElementById("pv-format") as HTMLElement).textContent =
          getFormValue("format") || "In-person";
        const start = getFormValue("startDate");
        const end = getFormValue("endDate");
        const dateLabel =
          end && start ? `${fmtShortDate(start)} – ${fmtShortDate(end)}` : fmtShortDate(start) || "—";
        (document.getElementById("pv-event-date") as HTMLElement).textContent = dateLabel;
        leadSummaryEl.classList.add("hidden");
        outputDownloadWrap.classList.add("hidden");
        downloadPdfBtn.classList.add("hidden");
      } else {
        (document.getElementById("pv-output-title") as HTMLElement).textContent = title;
        (document.getElementById("pv-output-summary") as HTMLElement).textContent = summary;

        leadSummaryEl.textContent = summary;
        leadSummaryEl.classList.remove("hidden");

        const fileUrl = getFormValue("fileUrl");
        const hasPdfOrUrl = Boolean(fileUrl || selectedPdfObjectUrl);
        clearPdfBtn.classList.toggle("hidden", !hasPdfOrUrl);
        downloadPdfBtn.classList.toggle("hidden", !selectedPdfFile);

        if (selectedPdfFile) {
          const targetPdfName = fileUrl.startsWith("/files/")
            ? fileUrl.replace(/^\/files\//, "")
            : getSuggestedPdfFilename();
          downloadPdfBtn.textContent = `↓ Save PDF (${targetPdfName})`;
        }

        if (hasPdfOrUrl) {
          outputDownloadWrap.classList.remove("hidden");
          outputDownloadLink.href = selectedPdfObjectUrl || fileUrl || "#";
          const isPdf = Boolean(selectedPdfObjectUrl || /\.pdf($|\?)/i.test(fileUrl));
          outputDownloadLink.textContent = isPdf
            ? "Download deliverable (PDF) ↗"
            : "Download deliverable ↗";

          if (selectedPdfObjectUrl) {
            outputPdfWrap.classList.remove("hidden");
            if (outputPdfFrame.src !== selectedPdfObjectUrl) {
              outputPdfFrame.src = selectedPdfObjectUrl;
            }
          } else {
            outputPdfWrap.classList.add("hidden");
            outputPdfFrame.removeAttribute("src");
          }
        } else {
          outputDownloadWrap.classList.add("hidden");
          outputPdfWrap.classList.add("hidden");
          outputPdfFrame.removeAttribute("src");
        }
      }

      // Article preview
      (document.getElementById("pv-article-title") as HTMLElement).textContent = title;
      const meta =
        currentType === "news"
          ? `Published · ${fmtDate(getFormValue("date") || todayISO)}`
          : currentType === "event"
            ? (() => {
                const s = getFormValue("startDate");
                const e = getFormValue("endDate");
                const dates = e && s ? `${fmtShortDate(s)} – ${fmtShortDate(e)}` : fmtShortDate(s);
                const loc = getFormValue("location");
                return [dates, loc].filter(Boolean).join(" · ") || "—";
              })()
            : (() => {
                const outId = (getFormValue("outputId") || "D6.1").toUpperCase();
                return `Output · ${outId}`;
              })();
      (document.getElementById("pv-article-meta") as HTMLElement).textContent = meta;
      (document.getElementById("pv-article-body") as HTMLElement).innerHTML =
        body.trim() ? (marked.parse(body) as string) : "<p><em>Body preview…</em></p>";

      // Markdown output + filename
      const md = buildFrontmatterAndBody();
      (document.getElementById("pv-markdown") as HTMLElement).textContent = md;
      (document.getElementById("pv-filename") as HTMLElement).textContent = buildFilename();
      const wordCount = body.trim() ? body.trim().split(/\s+/).length : 0;
      (document.getElementById("pv-word-count") as HTMLElement).textContent =
        `${wordCount} ${wordCount === 1 ? "word" : "words"}`;
    }

    form.addEventListener("input", updatePreview);
    form.addEventListener("change", updatePreview);

    // ── Markdown toolbar (Bold / Link / H2 / H3 / List / Quote) ─
    const bodyEl = document.getElementById("f-body") as HTMLTextAreaElement;

    function wrapSelection(before: string, after: string, placeholder: string): void {
      const start = bodyEl.selectionStart;
      const end = bodyEl.selectionEnd;
      const selected = bodyEl.value.slice(start, end) || placeholder;
      const newValue =
        bodyEl.value.slice(0, start) + before + selected + after + bodyEl.value.slice(end);
      bodyEl.value = newValue;
      bodyEl.focus();
      // Select the newly-inserted text so the user can immediately overtype it
      bodyEl.setSelectionRange(start + before.length, start + before.length + selected.length);
      bodyEl.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function prefixLines(prefix: string, placeholder: string): void {
      const start = bodyEl.selectionStart;
      const end = bodyEl.selectionEnd;
      const value = bodyEl.value;
      const lineStart = value.lastIndexOf("\n", start - 1) + 1;
      const lineEndIdx = value.indexOf("\n", end);
      const lineEnd = lineEndIdx === -1 ? value.length : lineEndIdx;
      const block = value.slice(lineStart, lineEnd) || placeholder;
      const prefixed = block
        .split("\n")
        .map((line) => (line ? prefix + line : prefix + placeholder))
        .join("\n");
      bodyEl.value = value.slice(0, lineStart) + prefixed + value.slice(lineEnd);
      bodyEl.focus();
      bodyEl.setSelectionRange(lineStart, lineStart + prefixed.length);
      bodyEl.dispatchEvent(new Event("input", { bubbles: true }));
    }

    document.querySelectorAll<HTMLButtonElement>(".md-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.dataset.md;
        switch (action) {
          case "bold":
            wrapSelection("**", "**", "bold text");
            break;
          case "link": {
            const linkUrl = window.prompt("Link URL:", "https://");
            if (!linkUrl) return;
            const selected =
              bodyEl.value.slice(bodyEl.selectionStart, bodyEl.selectionEnd) || "link text";
            wrapSelection("[", `](${linkUrl})`, selected);
            break;
          }
          case "h2":
            prefixLines("## ", "Section heading");
            break;
          case "h3":
            prefixLines("### ", "Sub-heading");
            break;
          case "list":
            prefixLines("- ", "List item");
            break;
          case "quote":
            prefixLines("> ", "Quoted text");
            break;
        }
      });
    });

    // ── Copy to clipboard + Download .md / PDF ─────────────────
    const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement;
    const downloadBtn = document.getElementById("download-btn") as HTMLButtonElement;
    const copyStatus = document.getElementById("copy-status") as HTMLElement;

    function flashStatus(msg: string): void {
      copyStatus.hidden = false;
      copyStatus.textContent = msg;
      setTimeout(() => (copyStatus.hidden = true), 3000);
    }

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(buildFrontmatterAndBody());
        flashStatus("Copied to clipboard ✓");
      } catch {
        flashStatus("Couldn't copy — select the text below and copy manually.");
      }
    });

    downloadBtn.addEventListener("click", () => {
      const md = buildFrontmatterAndBody();
      const filename = buildFilename();
      const blob = new Blob([md], { type: "text/markdown;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      flashStatus(`Downloaded ${filename} ✓`);
    });

    downloadPdfBtn.addEventListener("click", () => {
      if (!selectedPdfFile || !selectedPdfObjectUrl) return;
      const fileUrl = getFormValue("fileUrl");
      const targetPdfName = fileUrl.startsWith("/files/")
        ? fileUrl.replace(/^\/files\//, "")
        : getSuggestedPdfFilename();
      const a = document.createElement("a");
      a.href = selectedPdfObjectUrl;
      a.download = targetPdfName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      flashStatus(`Saved PDF as ${targetPdfName} ✓`);
    });

    // First render
    updatePreview();
  </script>
</BaseLayout>
