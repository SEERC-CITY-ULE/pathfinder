---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { url } from "~/lib/url";
import { site } from "~/data/site";

const tools = [
  {
    href: "/admin/compose/",
    title: "Compose a post",
    description:
      "Fill in a form, download the correctly-formatted file. Use this to draft news items, events, or output posts without touching GitHub.",
    icon: "✏️",
  },
  {
    href: "/admin/docs/",
    title: "Help & guides",
    description:
      "Click-by-click guides for adding photos, editing existing content, and everything else. Written for GitHub newcomers.",
    icon: "📖",
  },
];
---

<BaseLayout
  title="Admin"
  description="Internal tools and help for maintaining the PATHFINDER website."
  noindex
>
  <div class="container-wide py-10 md:py-14">
    <header class="mb-10 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-3">
        Internal
      </p>
      <h1 class="text-3xl md:text-5xl mb-4">Admin</h1>
      <p class="text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Internal tools for coordinators and the publisher. This page is unlisted — bookmark the URL
        if you use it regularly.
      </p>
    </header>

    <ul class="grid gap-5 md:grid-cols-2 max-w-4xl">
      {
        tools.map((t) => (
          <li>
            <a
              href={url(t.href)}
              class="surface-card p-6 md:p-8 h-full flex flex-col group"
            >
              <p class="text-3xl mb-3" aria-hidden="true">{t.icon}</p>
              <h2 class="font-display text-2xl leading-tight mb-3 group-hover:text-[var(--color-brand)] transition-colors">
                {t.title}
              </h2>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed flex-1">
                {t.description}
              </p>
              <p class="mt-4 text-sm font-semibold text-[var(--color-brand)] group-hover:underline underline-offset-4">
                Open →
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-sm text-[var(--color-ink-faint)] max-w-3xl">
      Need help or have a question? Contact <a href={`mailto:${site.coordinator.email}`} class="text-[var(--color-teal-deep)] underline underline-offset-3 hover:text-[var(--color-brand)]">{site.coordinator.email}</a>.
    </p>
  </div>
</BaseLayout>
